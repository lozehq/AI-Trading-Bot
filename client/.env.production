# ============================================
# 前端生产环境配置
# ============================================

# API基础地址（生产环境使用当前域名）
VITE_API_BASE_URL=

# WebSocket地址（生产环境使用当前域名）
VITE_WS_URL=

# 说明：
# 1. 留空表示使用当前域名
# 2. 如果使用Nginx反向代理，保持为空
# 3. 如果需要指定完整地址：
#    VITE_API_BASE_URL=http://your-server-ip:3000
#    VITE_WS_URL=ws://your-server-ip:3001
